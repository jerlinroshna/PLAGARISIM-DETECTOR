# Flask Server Configuration
FLASK_APP=app.py
FLASK_ENV=development
PORT=5000
SECRET_KEY=sih-plagiarism-detector-secret-key-2026-secure

# Analysis Engine Weights (Must sum to 1.0)
WEIGHT_TEXT=0.40
WEIGHT_AST=0.60

# Plagiarism Classification Thresholds (%)
THRESHOLD_HIGH=70.0
THRESHOLD_MEDIUM=30.0

# Upload limits (bytes)
MAX_CONTENT_LENGTH=5242880

# xAI Grok API Integration
# Obtain an API key from https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here
# Supported models include: grok-2-latest, grok-beta, grok-2-1212, grok-4.7
XAI_MODEL=grok-2-latest
# Base URL for xAI API (defaults to https://api.x.ai/v1)
XAI_BASE_URL=https://api.x.ai/v1
